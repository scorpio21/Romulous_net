<Project>
  <PropertyGroup>
    <!-- Enforce modern C# across all projects -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <AnalysisMode>All</AnalysisMode>

    <!-- Company / product metadata -->
    <Authors>ROMulus Contributors</Authors>
    <Company>ROMulus</Company>
    <Product>ROMulus</Product>
    <Copyright>Copyright © 2026 ROMulus Contributors</Copyright>
    <RepositoryUrl>https://github.com/Sphexi/ROMulous</RepositoryUrl>
    <Version>0.5.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      CA1056: URLs are stored as raw strings in SQLite / external APIs; Uri? adds friction.
      CA1062: Nullable context is enabled globally; null checks are enforced by the compiler.
      CA1305: Culture-variant conversions on internal SQL scalar results are intentional.
      CA1515: WPF code-behind classes (App, MainWindow) must be public for XAML.
      CA1707: xUnit convention uses Method_Condition_Expected underscore naming.
      CA1711: Domain types (RomCollection) end in reserved words intentionally.
      CA1724: Domain class names (Schema, Profile) may match .NET Framework types; OK here.
      CA2100: All SQL strings in this project are compile-time constants, not user input.
      CA2213: _conn lifetime is managed by ConnectionFactory.Dispose(), not the test directly.
    -->
    <NoWarn>$(NoWarn);CA1056;CA1062;CA1305;CA1515;CA1707;CA1711;CA1724;CA2100;CA2213</NoWarn>
  </PropertyGroup>
</Project>
